# ── Environment ────────────────────────────────
ENV=dev

# ── Required (both) ────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=QData_Agent
MCP_SERVER_URL=http://localhost:8000/mcp

# ── LLM (use one) ──────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=your-google-ai-studio-key

# ── Dev only ───────────────────────────────────
JWT_SECRET=generate-with-python-c-import-secrets-print-secrets-token-hex-32

# ── Prod only ──────────────────────────────────
KMS_KEY_ID=arn:aws:kms:ap-south-1:your-account:key/your-key-id
REDSHIFT_HOST=your-cluster.redshift.amazonaws.com
REDSHIFT_DATABASE=your_database
REDSHIFT_PORT=5439
ISSUER=qdataagent-client
AUDIENCE=qdataagent-mcp-server
ACCESS_TTL=3600
